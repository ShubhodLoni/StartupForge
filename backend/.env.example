# Required: get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq chat model that supports tool calling
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Optional but recommended: enables web search + real citations. https://app.tavily.com
TAVILY_API_KEY=
SEARCH_QUERIES=3
COMPETITOR_QUERIES=2
SEARCH_MAX_RESULTS=3

# Optional: PostgreSQL with pgvector. Without it, reports and vectors are kept in memory.
# DATABASE_URL=postgresql://startupforge:startupforge@localhost:5432/startupforge

# RAG over full page text (local fastembed embeddings; model downloads once, ~70 MB)
RAG_ENABLED=true
RAG_TOP_K=6

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
